                {
                  "listen": "test",
                  "script": {
                    "id": "196c9de3-8010-4194-94ba-51e6f090f95b",
                    "exec": [
                      "pm.test(\"Transactions fetched\", () => pm.response.to.have.status(200));\r",
                      "\r",
                      "const res = pm.response.json();\r",
                      "const transactionReference = pm.variables.get(\"transactionReference\"); \r",
                      "const transaction = res.data.find(t => t.ExternalReference === transactionReference);\r",
                      "\r",
                      "const commissionPct = parseFloat(pm.environment.get(\"commissionPct\"));\r",
                      "const faceValue = parseFloat(pm.environment.get(\"faceValue\"));\r",
                      "\r",
                      "const expectedCommission = (commissionPct / 100) * faceValue;\r",
                      "\r",
                      "// Example validation placeholder\r",
                      "pm.test(\"Commission calculated correctly\", () => {\r",
                      "    pm.expect(expectedCommission).to.eql(transaction.CommissionAmount);\r",
                      "});\r",
                      "\r",
                      "let products = JSON.parse(pm.environment.get(\"products\"));\r",
                      "let index = parseInt(pm.environment.get(\"productIndex\"));\r",
                      "\r",
                      "index++;\r",
                      "\r",
                      "if (index < products.length) {\r",
                      "    pm.environment.set(\"productIndex\", index);\r",
                      "    \r",
                      "    pm.execution.setNextRequest(\"Set Product Context\");\r",
                      "} else {\r",
                      "    pm.execution.setNextRequest(null);\r",
                      "}"
                    ],
                    "type": "text/javascript",
