            {
              "name": "Verify Bulk wallet deduction",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "id": "d9a38b73-1f4c-4032-9957-74b35849232d",
                    "exec": [
                      "const before = parseFloat(pm.environment.get(\"balance_before\"));\r",
                      "const after = parseFloat(pm.environment.get(\"balance_after\"));\r",
                      "const faceValue = parseFloat(pm.environment.get(\"faceValue\"));\r",
                      "\r",
                      "const count = pm.environment.get(\"bulk_count\");\r",
                      "const expectedDeduction = faceValue * count;\r",
                      "\r",
                      "pm.test(\"Bulk deduction correct\", () => {\r",
                      "   pm.expect(before - after).to.eql(expectedDeduction);\r",
                      "});\r",
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
